# Copy to .env next to docker-compose.yml. Never commit .env.

# Answer generation: anthropic (default) | openai | bedrock | extractive (no LLM)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# Embeddings: local (all-MiniLM-L6-v2, no key needed) | openai | bedrock
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=
# AWS_REGION=us-east-1   # bedrock uses the standard AWS credential chain

# News ingestion
FINNHUB_API_KEY=
NEWS_CRON_ENABLED=false
JWT_SECRET=change-me
